VITE_API_BASE_URL=/api
VITE_ENABLE_SWFT_WORKSPACE=false

# ── Entra ID authentication (MSAL) ─────────────────────────────────────────────
# Set VITE_AUTH_ENABLED=true to enable login. All other vars are required when enabled.
# VITE_AUTH_AUTHORITY_HOST defaults to Azure Government; use https://login.microsoftonline.com for commercial.
VITE_AUTH_ENABLED=true
VITE_AUTH_CLIENT_ID=          # frontend SPA app registration client ID
VITE_AUTH_TENANT_ID=            # your Azure AD tenant ID
VITE_AUTH_AUTHORITY_HOST=https://login.microsoftonline.us
VITE_AUTH_REDIRECT_URI=          # e.g. https://your-app.us or localhost URL for dev (e.g. http://localhost:5173) (leave blank for window.location.origin)
VITE_AUTH_API_SCOPE=
