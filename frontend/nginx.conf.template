server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    # Serve compiled assets with sensible defaults.
    root   /usr/share/nginx/html;
    index  index.html;

    # ---- API reverse proxy ----
    # Mirrors the Vite dev-server proxy in vite.config.ts:
    #   /api/projects  →  <backend>/projects
    # The backend URL is injected at container startup via envsubst.
    location /api/ {
        rewrite ^/api/(.*) /$1 break;
        proxy_pass ${API_BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 60s;
    }

    # React router fallback.
    location / {
        try_files $uri /index.html;
    }

    # Cache static assets aggressively; they include content hashes.
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        expires 7d;
        access_log off;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    # Basic security headers for static hosting.
    add_header X-Frame-Options "DENY";
    add_header X-Content-Type-Options "nosniff";
    add_header Referrer-Policy "no-referrer-when-downgrade";
}
