# Azure Storage configuration
# Option A: connection string auth (takes priority when set)
AZURE_STORAGE_CONNECTION_STRING= #get connection string
# Option B: managed identity / az login — set account name, remove connection string
AZURE_STORAGE_ACCOUNT= # get storage account
AZURE_STORAGE_CONTAINER_SBOMS=sboms
AZURE_STORAGE_CONTAINER_SCANS=scans
AZURE_STORAGE_CONTAINER_RUNS=runs

# Azure AD service principal (optional when using managed identity)
AZURE_TENANT_ID = #get tenant id
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# # Local development override (point to extracted blobs instead of Azure)
# LOCAL_BLOB_ROOT=

# # Cache behaviour
# CACHE_TTL_SECONDS=60
# CACHE_MAX_ITEMS=256

# # Compliance database (SWFT workspace)
# SWFT_DB_HOST=
# SWFT_DB_NAME=
# SWFT_DB_USER=adminuser
# SWFT_DB_AUTH=entra
# SWFT_DB_PASSWORD=<password>
# SWFT_DB_PORT=5432
# SWFT_DB_TIMEOUT=30
# SWFT_DB_AAD_SCOPE=https://ossrdbms-aad.database.windows.net/.default


# ── Entra ID authentication ────────────────────────────────────────────────────
# Set AUTH_ENABLED=true to enforce Bearer token validation on all API endpoints.
# AUTH_CLIENT_ID must match the backend app registration's Application (client) ID.
# AUTH_AUTHORITY_HOST defaults to Azure Government; set to https://login.microsoftonline.com for commercial.
AUTH_ENABLED=true
AUTH_CLIENT_ID=          # backend app registration client ID
AUTH_AUTHORITY_HOST=https://login.microsoftonline.us
# AZURE_TENANT_ID is shared with storage auth above

OPENAI_PROVIDER=azure
# Option A: API key auth
OPENAI_API_KEY= # get AOAI key  # Not needed when using managed identity
# Option B: managed identity / az login (no API key required)
# OPENAI_USE_MANAGED_IDENTITY=true
OPENAI_API_BASE= # get AOAI endpoint, make sure it ends with a trailing /
OPENAI_API_VERSION=2024-10-21   # match your deployment; if get 404, look up last valid API version
# OPENAI_ORG_ID=
ASSISTANT_MODEL_CONFIG_PATH=backend/app/assistant/model_config.json
ASSISTANT_HISTORY_TTL_SECONDS=900
ASSISTANT_HISTORY_MAX_ITEMS=256
